[
  {
    "$id": "matrixflow-core",
    "name": "MatrixFlow Core",
    "path": "../../apps/functions/matrixflow-core",
    "runtime": "node-22",
    "entrypoint": "src/main.js",
    "commands": "npm ci --omit=dev",
    "execute": ["any"],
    "enabled": true,
    "logging": true,
    "deploymentRetention": 5,
    "timeout": 120,
    "scopes": [
      "teams.read",
      "rows.read",
      "rows.write",
      "buckets.read",
      "files.read",
      "files.write",
      "executions.write"
    ],
    "ignore": ["node_modules", ".git", "coverage", "*.log"]
  }
]

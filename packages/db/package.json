{
  "name": "@matrixflow/db",
  "version": "0.1.0",
  "private": true,
  "description": "MatrixFlow AI · Prisma schema + client + migrations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-generated.js && node ../../scripts/patch-edge.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist generated"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "prisma": "7.9.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}

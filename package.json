{
  "name": "matrixflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MatrixFlow AI — AI 员工操作系统（跨境电商 AI 运营团队 SaaS 平台）",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @matrixflow/db generate",
    "db:migrate": "pnpm --filter @matrixflow/db migrate",
    "db:seed": "pnpm --filter @matrixflow/db seed",
    "db:studio": "pnpm --filter @matrixflow/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@eslint/eslintrc": "3.2.0",
    "@faker-js/faker": "9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.21",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}

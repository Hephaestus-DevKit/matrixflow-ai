{
  "name": "matrixflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MatrixFlow AI — AI 员工操作系统（跨境电商 AI 运营团队 SaaS 平台）",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @matrixflow/db generate",
    "db:migrate": "pnpm --filter @matrixflow/db migrate",
    "db:seed": "pnpm --filter @matrixflow/db seed",
    "db:studio": "pnpm --filter @matrixflow/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/eslintrc": "3.3.6",
    "@faker-js/faker": "10.5.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  }
}

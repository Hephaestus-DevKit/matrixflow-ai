{
  "name": "@matrixflow/web",
  "version": "0.1.0",
  "private": true,
  "description": "MatrixFlow AI · Next.js 前端",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "corepack pnpm --filter @matrixflow/shared run build && next build",
    "start": "next start -p 3000",

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@matrixflow/shared": ["../../packages/shared/src"],
      "@matrixflow/ai-gateway": ["../../packages/ai-gateway/src"],
      "@matrixflow/workflow-engine": ["../../packages/workflow-engine/src"],
      "@matrixflow/db": ["../../packages/db/src"]
    }
  },
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/ai-gateway" },
    { "path": "../../packages/workflow-engine" },
    { "path": "../../packages/db" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

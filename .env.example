# Browser-safe Appwrite configuration. These identifiers are public by design.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6a43f0af000862e7b0ef

# Appwrite Function variables (set in Appwrite Console, never expose to the browser).
# Configure one provider; GLM takes precedence when both are present.
GLM_API_KEY=
GLM_MODEL=glm-4-plus
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Deployment automation only. Use an ephemeral key and revoke it after deployment.
MATRIXFLOW_DEPLOY_KEY=
MATRIXFLOW_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
MATRIXFLOW_APPWRITE_PROJECT_ID=6a43f0af000862e7b0ef

# ============================================================
# MatrixFlow AI · 环境变量模板
# 复制为 .env 并填入真实值。生产环境禁用默认弱密钥。
# ============================================================

# ---- 运行环境 ----
NODE_ENV=development
PORT=3001
WEB_PORT=3000
LOG_LEVEL=debug            # trace|debug|info|warn|error
REQUEST_ID_HEADER=x-request-id
TRUST_PROXY_HOPS=0             # set to the exact number of trusted reverse proxies

# ---- 前端 ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000

# ---- 数据库 (PostgreSQL 16 + pgvector) ----
DATABASE_URL=postgresql://matrixflow:matrixflow@localhost:5432/matrixflow?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_LOG_LEVEL=query    # off|error|warn|query|info

# ---- Redis (缓存/队列/限流/会话) ----
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=mfa:
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000

# ---- JWT / 认证 ----
AUTH_MODE=appwrite                 # production: appwrite; local JWT is explicit dev/test only
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
JWT_SECRET=change-me-to-a-64-char-random-string-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=matrixflow.ai
PLATFORM_ADMIN_IDS=             # comma-separated user UUIDs; required for /admin
PLATFORM_ADMIN_EMAILS=          # comma-separated emails; required for /admin
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# ---- OAuth (P1，留空则禁用) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback/github

# ---- AI 模型网关 ----
# GLM (主模型)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_DEFAULT_MODEL=glm-4-plus
GLM_TIMEOUT_MS=60000

# OpenAI (fallback / 预留)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000

# Anthropic (fallback / 预留)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest

# Google Gemini (fallback / 预留)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# AI 网关通用
AI_CACHE_TTL_SECONDS=3600
AI_RATE_LIMIT_PER_MIN=60
AI_MAX_RETRY=3
AI_RETRY_BACKOFF_MS=500
AI_STREAM_TIMEOUT_MS=120000

# ---- Embedding (P0 用 GLM embedding-3，预留 OpenAI text-embedding-3-small) ----
EMBEDDING_PROVIDER=glm
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1536

# ---- 对象存储 (MinIO / S3 兼容) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=matrixflow
MINIO_SECRET_KEY=matrixflow123
MINIO_BUCKET=matrixflow
MINIO_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---- 文件上传 ----
UPLOAD_MAX_BYTES=20971520        # 20MB
UPLOAD_ALLOWED_TYPES=pdf,docx,txt,md,csv
SIDECAR_TIMEOUT_MS=60000
SIDECAR_MAX_FILE_BYTES=20971520
SIDECAR_MAX_EXTRACTED_CHARS=5000000
SIDECAR_MAX_PDF_PAGES=1000
SIDECAR_MAX_DOCX_FILES=10000
SIDECAR_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
SIDECAR_MAX_CHUNKS=10000

# ---- 队列 / BullMQ ----
QUEUE_CONCURRENCY=4
QUEUE_MAX_RETRIES=5
QUEUE_BACKOFF_TYPE=exponential
INTERNAL_API_URL=http://localhost:3001/api/v1
INTERNAL_JOB_TIMEOUT_MS=300000
DOCUMENT_PROCESSING_LEASE_MS=600000
WORKFLOW_RUN_LEASE_MS=600000
WORKFLOW_WEBHOOK_TIMEOUT_MS=15000
WORKFLOW_WEBHOOK_MAX_RESPONSE_BYTES=1000000

# ---- 计费 ----
BILLING_CURRENCY=USD
STRIPE_SECRET_KEY=              # P1 接入 Stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---- 安全 ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_SECONDS=60
INTERNAL_JOB_SECRET=change-me-to-a-64-char-random-string
COOKIE_DOMAIN=localhost
SECURE_COOKIES=false            # 生产置 true
PROMPT_INJECTION_DETECTION=on   # on|off
AUDIT_LOG_ENABLED=true

# ---- 监控 (P1) ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- 邮件 (P1, 开发用 MailHog) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MatrixFlow AI <noreply@matrixflow.ai>

# ---- Python Sidecar (P1, 文档解析/Embedding) ----
SIDECAR_PYTHON_URL=http://localhost:8001

# ---- 多区域部署 (P2) ----
REGION=us-east-1

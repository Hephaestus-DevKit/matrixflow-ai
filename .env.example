# Browser-safe Appwrite configuration. These identifiers are public by design.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6a43f0af000862e7b0ef

# Appwrite Function variables (set in Appwrite Console, never expose to the browser).
# Protocol selection: auto (default), anthropic, openai/openai-compatible,
# tokenrhythm, or glm.
# Auto mode preserves existing GLM deployments, then falls back to Anthropic/OpenAI.
MATRIXFLOW_AI_PROVIDER=auto
MATRIXFLOW_AI_TIMEOUT_MS=25000
MATRIXFLOW_AI_MAX_RETRIES=2
# In auto mode a transient provider failure can fail over to the next
# configured protocol. Keep private/insecure endpoints disabled in production.
MATRIXFLOW_AI_FALLBACK=true
MATRIXFLOW_REQUIRE_PROVIDER=false
MATRIXFLOW_REQUIRE_ASYNC=false
MATRIXFLOW_REQUIRE_BILLING=false
MATRIXFLOW_ALLOW_INSECURE_PROVIDER=false
MATRIXFLOW_ALLOW_PRIVATE_PROVIDER=false
MATRIXFLOW_CONNECTOR_ALLOWLIST=
MATRIXFLOW_ALERT_WEBHOOK_URL=
MATRIXFLOW_BACKUP_EVIDENCE_URL=
MATRIXFLOW_BACKUP_LAST_SUCCESS_AT=
MATRIXFLOW_RESTORE_EVIDENCE_URL=
MATRIXFLOW_RESTORE_LAST_SUCCESS_AT=
# Optional JSON price table used only for internal usage/cost analytics.
# Example: {"openai:gpt-4o-mini":{"inputPer1k":0.00015,"outputPer1k":0.0006}}
MATRIXFLOW_AI_PRICING_JSON=

# Native Anthropic Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BETA=

# OpenAI Chat Completions protocol. OPENAI_BASE_URL can point to any compatible gateway.
OPENAI_API_KEY=
# Optional alias for gateways where the key is managed independently.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS_FIELD=max_completion_tokens
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# Token Rhythm (OpenAI-compatible; recommended MatrixFlow production gateway).
# Keep the key as an Appwrite Function secret. These aliases are optional when
# using the generic OPENAI_COMPATIBLE_API_KEY / OPENAI_BASE_URL variables.
TOKENRHYTHM_API_KEY=
TOKENRHYTHM_MODEL=deepseek-v4-flash-0731
TOKENRHYTHM_BASE_URL=https://tokenrhythm.studio/v1

# Legacy GLM OpenAI-compatible endpoint.
GLM_API_KEY=
GLM_MODEL=glm-4-plus
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
MATRIXFLOW_AI_MONTHLY_LIMIT=100
MATRIXFLOW_AI_PER_MINUTE_LIMIT=20
MATRIXFLOW_REQUESTS_PER_MINUTE=120
MATRIXFLOW_AGENT_LIMIT=10
MATRIXFLOW_CONTENT_PROJECT_LIMIT=10
MATRIXFLOW_KNOWLEDGE_BASE_LIMIT=5
MATRIXFLOW_WORKFLOW_LIMIT=3
# Secret pepper for HMAC-hashing MatrixFlow API Keys. Set a random 32+ character
# value in Appwrite Function secrets; production refuses API Key operations without it.
MATRIXFLOW_API_KEY_PEPPER=
# Secret used only for Appwrite-to-Appwrite background worker invocations;
# generate a 32+ character random value in the Appwrite Function console.
MATRIXFLOW_WORKER_SECRET=
# Async execution lease controls. Keep the heartbeat comfortably below the
# lease so a crashed worker can be reclaimed without duplicate execution.
MATRIXFLOW_JOB_LEASE_MS=90000
MATRIXFLOW_JOB_HEARTBEAT_MS=15000

# Optional signed billing adapter. Keep this only in Appwrite Function secrets.
# Webhooks must send X-MatrixFlow-Billing-Signature: sha256=<HMAC-SHA256(raw-body)>.
MATRIXFLOW_BILLING_WEBHOOK_SECRET=
MATRIXFLOW_BILLING_PROVIDER=
MATRIXFLOW_ALLOW_TEST_BILLING=false
MATRIXFLOW_PUBLIC_URL=https://matrixflow-ai.vercel.app
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_WEBHOOK_SECRET=

# Deployment automation only. Use an ephemeral key and revoke it after deployment.
MATRIXFLOW_DEPLOY_KEY=
MATRIXFLOW_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
MATRIXFLOW_APPWRITE_PROJECT_ID=6a43f0af000862e7b0ef

# Browser-safe Appwrite configuration. These identifiers are public by design.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6a43f0af000862e7b0ef

# Appwrite Function variables (set in Appwrite Console, never expose to the browser).
# Protocol selection: auto (default), anthropic, openai/openai-compatible, or glm.
# Auto mode preserves existing GLM deployments, then falls back to Anthropic/OpenAI.
MATRIXFLOW_AI_PROVIDER=auto
MATRIXFLOW_AI_TIMEOUT_MS=25000
MATRIXFLOW_AI_MAX_RETRIES=2

# Native Anthropic Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BETA=

# OpenAI Chat Completions protocol. OPENAI_BASE_URL can point to any compatible gateway.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS_FIELD=max_completion_tokens
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# Legacy GLM OpenAI-compatible endpoint.
GLM_API_KEY=
GLM_MODEL=glm-4-plus
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
MATRIXFLOW_AI_MONTHLY_LIMIT=100
MATRIXFLOW_AI_PER_MINUTE_LIMIT=20

# Deployment automation only. Use an ephemeral key and revoke it after deployment.
MATRIXFLOW_DEPLOY_KEY=
MATRIXFLOW_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
MATRIXFLOW_APPWRITE_PROJECT_ID=6a43f0af000862e7b0ef

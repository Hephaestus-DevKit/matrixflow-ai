# ============================================================
# MatrixFlow AI · 环境变量模板
# 复制为 .env 并填入真实值。生产环境禁用默认弱密钥。
# ============================================================

# ---- 运行环境 ----
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug                # trace|debug|info|warn|error
TRUST_PROXY_HOPS=0             # 可信反向代理的精确跳数

# ---- 前端 ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# ---- 数据库 (PostgreSQL 16 + pgvector) ----
DATABASE_URL=postgresql://matrixflow:matrixflow@localhost:5432/matrixflow?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# ---- Redis (缓存/队列/限流/会话) ----
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=mfa:
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000

# ---- JWT / 认证 ----
AUTH_MODE=appwrite                 # production: appwrite; local JWT is explicit dev/test only
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
JWT_SECRET=change-me-to-a-64-char-random-string-in-prod
JWT_ACCESS_TTL=15m
JWT_ISSUER=matrixflow.ai
JWT_AUDIENCE=matrixflow-api
PLATFORM_ADMIN_IDS=          # 逗号分隔的用户 UUID；/admin 不接受邮箱白名单
BCRYPT_ROUNDS=12

# ---- AI 模型网关 ----
# GLM (主模型)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_DEFAULT_MODEL=glm-4-plus
GLM_EMBEDDING_MODEL=embedding-3
GLM_TIMEOUT_MS=60000

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=60000

# AI 网关通用
AI_PROVIDER_REQUIRED=true       # false 时允许 API 降级启动，AI 功能保持不可用
AI_CACHE_TTL_SECONDS=3600
AI_RATE_LIMIT_PER_MIN=60

# ---- Embedding ----
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1536
EMBEDDING_CONCURRENCY=4

# ---- 对象存储 (MinIO / S3 兼容) ----
OBJECT_STORAGE_REQUIRED=true    # false 时允许 API 降级启动，文件功能保持不可用
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=matrixflow
MINIO_SECRET_KEY=matrixflow123
MINIO_BUCKET=matrixflow

# ---- 文件上传 ----
UPLOAD_MAX_BYTES=20971520        # 20MB
UPLOAD_ALLOWED_TYPES=pdf,docx,txt,md,csv
SIDECAR_TIMEOUT_MS=60000
SIDECAR_MAX_FILE_BYTES=20971520
SIDECAR_MAX_EXTRACTED_CHARS=5000000
SIDECAR_MAX_PDF_PAGES=1000
SIDECAR_MAX_DOCX_FILES=10000
SIDECAR_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
SIDECAR_MAX_CHUNKS=10000

# ---- 队列 / BullMQ ----
QUEUE_CONCURRENCY=4
QUEUE_MAX_RETRIES=5
QUEUE_BACKOFF_TYPE=exponential
INTERNAL_API_URL=http://localhost:3001/api/v1
INTERNAL_JOB_TIMEOUT_MS=300000
DOCUMENT_PROCESSING_LEASE_MS=600000
WORKFLOW_RUN_LEASE_MS=600000
WORKFLOW_WEBHOOK_TIMEOUT_MS=15000
WORKFLOW_WEBHOOK_MAX_RESPONSE_BYTES=1000000

# ---- 安全 ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_SECONDS=60
INTERNAL_JOB_SECRET=change-me-to-a-64-char-random-string
PROMPT_INJECTION_DETECTION=on   # on|off

# ---- 监控 ----
METRICS_TOKEN=change-me-to-a-32-char-random-string

# ---- Python Sidecar（文档解析）----
SIDECAR_PYTHON_URL=http://localhost:8001
